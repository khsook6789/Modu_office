# ==========================================
# docker-compose 환경변수 (.env)
#
# [모드 전환]
# 부하 테스트:  POSTGRES_DB, DATA_SEEDING_ENABLED, NGINX_CONF 값을 변경
# 프로덕션:     아래 기본값(prod 설정)을 사용하면 됨
# ==========================================

# PostgreSQL
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT (Base64 인코딩된 32바이트 이상 시크릿)
JWT_SECRET=your_base64_jwt_secret

# Naver OAuth2
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Google Maps (백엔드 지오코딩 + 프론트엔드 지도)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Toss Payments
TOSS_SECRET_KEY=your_toss_secret_key

# Sentry 에러 모니터링
SENTRY_DSN=your_sentry_dsn

# Frontend Build Args
VITE_API_BASE_URL=http://localhost:8080/api

# ── 모드 전환 변수 ─────────────────────────────────
# [프로덕션 기본값]
POSTGRES_DB=modu_office
DATA_SEEDING_ENABLED=false
DATA_CLEAN_BEFORE_SEEDING=false
NGINX_CONF=./frontend/nginx.conf
# [부하 테스트 모드로 전환 시 아래로 교체]
# POSTGRES_DB=modu_office_loadtest
# DATA_SEEDING_ENABLED=true
# DATA_CLEAN_BEFORE_SEEDING=true
# NGINX_CONF=./load-test/nginx-loadtest.conf
# ────────────────────────────────────────────────
